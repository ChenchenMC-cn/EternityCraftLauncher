<Window x:Class="ECL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:ECL.Converters"
        Title="Eternity Craft Launcher"
        Width="1160" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgWindow}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:PageToBoolConverter x:Key="PageToBool" />
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- ============================================ title bar ========== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource AccentGradient}">
                    <TextBlock Text="E" FontSize="15" FontWeight="Bold" Foreground="{StaticResource OnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="ETERNITY CRAFT" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBlock Text="LAUNCHER" FontSize="12" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="8,0,0,0" />
                <Border Style="{StaticResource Badge}" Background="{StaticResource BadgeBg}" Margin="10,0,0,0">
                    <!-- Must stay bound: this used to be a hard-coded "BETA 0.8" and the version bump missed it. -->
                    <TextBlock Text="{Binding AppVersionBadge}" FontSize="10" Foreground="{StaticResource Accent}" />
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0"
                        VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="最小化" />
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" x:Name="MaxButton" ToolTip="最大化" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="关闭" />
            </StackPanel>
        </Grid>

        <!-- ============================================ body =============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="68" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgSidebar}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE80F;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=0, Mode=TwoWay}"
                                     ToolTip="主页" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE896;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=1, Mode=TwoWay}"
                                     ToolTip="安装版本" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE8F1;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=2, Mode=TwoWay}"
                                     ToolTip="模组" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE77B;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=3, Mode=TwoWay}"
                                     ToolTip="账户" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE713;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=4, Mode=TwoWay}"
                                     ToolTip="设置" />
                        <RadioButton Style="{StaticResource NavButton}" GroupName="nav" Content="&#xE7C3;"
                                     IsChecked="{Binding ActivePage, Converter={StaticResource PageToBool}, ConverterParameter=5, Mode=TwoWay}"
                                     ToolTip="日志" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion}" FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14" />
                </Grid>
            </Border>

            <!-- ======================= page: home ==================== -->
            <Grid Grid.Column="1" Style="{StaticResource PageFade}" Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="40,30,40,0">
                    <TextBlock Text="准备开始" FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="选择一个版本，然后开始游戏" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- account card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="40,20,40,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="46" Height="46" VerticalAlignment="Center">
                            <Border CornerRadius="23" Background="{Binding AccountBadgeColor}">
                                <TextBlock Text="{Binding AccountInitial}" FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- Real Minecraft face when the skin is known (PCL-style);
                                 the coloured circle stays as the fallback. -->
                            <Ellipse Visibility="{Binding HasAccountAvatar, Converter={StaticResource BoolToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding AccountAvatar}" Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountName}" FontSize="15.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="{Binding AccountTypeLabel}" FontSize="11.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="管理账户"
                                VerticalAlignment="Center" Height="32"
                                Command="{Binding NavigateCommand}" CommandParameter="3" />
                    </Grid>
                </Border>

                <!-- installed versions -->
                <Grid Grid.Row="2" Margin="40,22,40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="已安装的版本" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="刷新" Height="30" FontSize="12"
                                    Margin="0,0,8,0" Command="{Binding RefreshInstalledCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="安装新版本" Height="30" FontSize="12"
                                    Command="{Binding NavigateCommand}" CommandParameter="1" />
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding InstalledVersions}"
                             SelectedItem="{Binding SelectedInstalled, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource InstalledCard}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasInstalled, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource BadgeBg}"
                                            HorizontalAlignment="Left" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{Binding KindBadgeForeground}" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SubText}" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="26,22"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasNoInstalled, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="还没有安装任何版本" FontSize="14"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                            <TextBlock Text="去安装页选择 Minecraft 版本，或加上 Fabric / Forge"
                                       FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                       Margin="0,7,0,0" HorizontalAlignment="Center" />
                            <!--
                                Spells out where the launcher is actually reading. People who
                                drop an existing .minecraft in place expect their versions to
                                show up; without this line an empty list looks like a bug.
                            -->
                            <TextBlock Text="{Binding DataRootHint}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       MaxWidth="440" TextAlignment="Center"
                                       Margin="0,5,0,0" HorizontalAlignment="Center" />

                            <!-- Found a .minecraft elsewhere: one line + the button below. -->
                            <Border Visibility="{Binding HasExistingInstall, Converter={StaticResource BoolToVis}}"
                                    Background="{StaticResource BgInput}"
                                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="8" Padding="14,10" Margin="0,14,0,0" MaxWidth="470">
                                <StackPanel>
                                    <TextBlock Text="{Binding ExistingInstallText}" FontSize="11.5"
                                               Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ExistingInstallDetail}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="去安装" Width="150" Height="38"
                                        Command="{Binding NavigateCommand}" CommandParameter="1" />
                                <Button Style="{StaticResource GhostButton}" Content="使用这个目录"
                                        Height="38" Padding="16,0" Margin="10,0,0,0"
                                        Visibility="{Binding HasExistingInstall, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding AdoptExistingInstallCommand}" />
                                <!-- Fallback for installs the scan cannot guess (D:\Games\.minecraft). -->
                                <Button Style="{StaticResource GhostButton}" Content="选择目录…"
                                        Height="38" Padding="16,0" Margin="10,0,0,0"
                                        Command="{Binding BrowseForInstallCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- launch -->
                <StackPanel Grid.Row="3" Margin="40,16,40,26">
                    <Border x:Name="ErrorBar" Style="{StaticResource Card}" Background="{StaticResource ErrorCardBg}"
                            BorderBrush="{StaticResource ErrorCardBorder}" Padding="14,10" Margin="0,0,0,12"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
                    </Border>

                    <!-- per-version JVM overrides; empty inherits the global setting -->
                    <Grid Margin="0,0,0,12"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="启动参数（高级）" FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBox Text="{Binding SelectedVersionJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" VerticalContentAlignment="Center"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                     ToolTip="只对当前选中的版本生效；留空则继承设置页里的全局参数" />
                            <TextBlock Text="{Binding SelectedVersionJvmHint}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- per-version maintenance: verify / repair / open folder -->
                    <Grid Margin="0,0,0,12"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="校验文件"
                                    Height="30" FontSize="11.5" Padding="12,0"
                                    Command="{Binding VerifyVersionCommand}"
                                    ToolTip="逐个核对游戏文件对不对（按官方记录比大小和指纹）" />
                            <Button Style="{StaticResource GhostButton}" Content="补全文件"
                                    Height="30" FontSize="11.5" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding RepairVersionCommand}"
                                    ToolTip="重新核对并下载缺失或损坏的文件，已正常的会跳过" />
                            <Button Style="{StaticResource GhostButton}" Content="打开目录"
                                    Height="30" FontSize="11.5" Padding="12,0" Margin="8,0,0,0"
                                    Command="{Binding OpenVersionFolderCommand}" />
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding VerifySummary}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- verification failures; capped height so a broken install cannot
                         push the launch button off screen -->
                    <ListBox ItemsSource="{Binding VerifyIssues}" MaxHeight="110" Margin="0,0,0,12"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource CompactRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasVerifyIssues, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="10.5"
                                               Foreground="{StaticResource ErrorText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ShortPath}" FontSize="10.5"
                                               FontFamily="{StaticResource MonoFont}"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"
                                               Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedVersionSummary}" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Text="{Binding JavaHint}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding LaunchButtonText}"
                                Width="260" HorizontalAlignment="Right" Command="{Binding LaunchCommand}" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- ======================= page: install ================= -->
            <Grid Grid.Column="1" Style="{StaticResource PageFade}" Visibility="{Binding IsInstallPage, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="312" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="18,20,14,10">
                            <StackPanel>
                                <TextBlock Text="Minecraft 版本" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="先选本体，再选加载器" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowSnapshots}"
                                          ToolTip="显示快照版本" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button Style="{StaticResource CaptionButton}" Content="&#xE72C;"
                                        Command="{Binding RefreshCommand}" ToolTip="刷新版本列表" />
                            </StackPanel>
                        </Grid>

                        <ListBox x:Name="VersionList" Grid.Row="1" ItemsSource="{Binding Versions}"
                                 SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Margin="10,0,8,10"
                                 ItemContainerStyle="{StaticResource VersionListItem}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Id}" FontSize="13" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="  ·  " FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding ReleaseText}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{StaticResource AccentTint}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="已安装" FontSize="10" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="30,24,30,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="30" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedVersionMeta}" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,22,0,0">
                        <TextBlock Text="加载器" Style="{StaticResource SectionLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource LoaderCard}" GroupName="loader"
                                         IsChecked="{Binding LoaderIndex, Converter={StaticResource PageToBool}, ConverterParameter=0, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="原版" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Vanilla" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource LoaderCard}" GroupName="loader"
                                         IsChecked="{Binding LoaderIndex, Converter={StaticResource PageToBool}, ConverterParameter=1, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Fabric" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="轻量 · 快" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource LoaderCard}" GroupName="loader"
                                         IsChecked="{Binding LoaderIndex, Converter={StaticResource PageToBool}, ConverterParameter=2, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Quilt" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Fabric 分支" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource LoaderCard}" GroupName="loader"
                                         IsChecked="{Binding LoaderIndex, Converter={StaticResource PageToBool}, ConverterParameter=3, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Forge" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="生态最大" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource LoaderCard}" GroupName="loader"
                                         IsChecked="{Binding LoaderIndex, Converter={StaticResource PageToBool}, ConverterParameter=4, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="OptiFine" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="光影 · 优化" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <!-- Empty loader list = this loader has no builds for that version
                             (Fabric on 1.8.9). Saying so beats a silent empty dropdown. -->
                        <TextBlock Text="{Binding LoaderSupportHint}" FontSize="11"
                                   Foreground="{StaticResource WarnText}" TextWrapping="Wrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasLoaderSupportHint, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Text="{Binding LoaderHint}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,16,0,0"
                          Visibility="{Binding ShowLoaderPicker, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource Card}" Padding="12,8" Height="150">
                            <Grid>
                                <TextBlock Text="正在读取版本列表…" FontSize="12" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Visibility="{Binding IsLoadingLoaders, Converter={StaticResource BoolToVis}}" />
                                <ListBox ItemsSource="{Binding LoaderVersions}"
                                         SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource CompactRow}"
                                         Visibility="{Binding IsLoadingLoaders, Converter={StaticResource InverseBoolToVis}}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimary}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- OptiFine rides along as a Forge mod: no extra profile -->
                        <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0"
                                Visibility="{Binding IsForgeLoader, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="同时装上 OptiFine" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <TextBlock Text="作为 Forge 模组放进 mods 目录，不额外生成版本"
                                                   FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding InstallOptiFineWithForge}" />
                                </Grid>
                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding ShowForgeOptiFineList, Converter={StaticResource BoolToVis}}">
                                    <ComboBox Style="{StaticResource DarkCombo}"
                                              ItemsSource="{Binding ForgeOptiFineBuilds}"
                                              SelectedItem="{Binding SelectedForgeOptiFineBuild, Mode=TwoWay}" />
                                    <TextBlock Text="{Binding ForgeOptiFineDetail}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" Margin="2,5,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SelectedLoaderDetail}" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" Margin="2,6,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Row="3" Margin="0,14,0,0"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding StageText}" FontSize="12.5" Foreground="{StaticResource TextPrimary}" />
                        <ProgressBar Style="{StaticResource ThinProgress}" Height="5" Value="{Binding ProgressValue}"
                                     Maximum="1" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,0,0,24">
                        <Border Style="{StaticResource Card}" Background="{StaticResource ErrorCardBg}" BorderBrush="{StaticResource ErrorCardBorder}"
                                Padding="14,10" Margin="0,0,0,12"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorText}" FontSize="12" Foreground="{StaticResource ErrorText}" TextWrapping="Wrap" />
                        </Border>
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding InstallButtonText}"
                                Command="{Binding InstallCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ======================= page: mods =================== -->
            <Grid Grid.Column="1" Style="{StaticResource PageFade}" Visibility="{Binding IsModsPage, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="40,30,40,0">
                    <TextBlock Text="模组" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="每个版本有独立的 mods 目录；启用与禁用只改文件名，移除会先放进 .ecl-trash"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="40,20,40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox Style="{StaticResource DarkCombo}" Width="250"
                                  ItemsSource="{Binding InstalledVersions}"
                                  SelectedItem="{Binding SelectedInstalled, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />
                        <TextBlock Text="{Binding ModsSummary}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="打开目录" Height="32" FontSize="12"
                                Margin="0,0,8,0" Command="{Binding OpenModsFolderCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="刷新" Height="32" FontSize="12"
                                Margin="0,0,8,0" Command="{Binding RefreshModsCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="{Binding MarketToggleLabel}"
                                Height="32" FontSize="12" Margin="0,0,8,0" Command="{Binding ToggleMarketCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="导入模组" Width="112" Height="32"
                                FontSize="12.5" Command="{Binding ImportModCommand}" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Margin="40,10,40,0">
                    <TextBlock Text="{Binding ModsPathText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    <Border Style="{StaticResource Card}" Background="{StaticResource WarnCardBg}" BorderBrush="{StaticResource WarnCardBorder}"
                            Padding="12,9" Margin="0,10,0,0"
                            Visibility="{Binding HasModsWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ModsWarning}" FontSize="11.5" Foreground="{StaticResource WarnText}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Modrinth marketplace -->
                    <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,10,0,0"
                            Visibility="{Binding IsMarketOpen, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Modrinth 模组市场" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{Binding MarketFilterText}" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0"
                                  Visibility="{Binding CanSearchMods, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ModSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="搜索模组，例如 sodium / lithium / iris" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="搜索"
                                        Height="32" Margin="8,0,0,0" Command="{Binding SearchMarketCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding MarketUnavailableHint}" FontSize="11"
                                       Foreground="{StaticResource TextMuted}" Margin="0,12,0,0"
                                       Visibility="{Binding CanSearchMods, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="正在搜索…" FontSize="12" Foreground="{StaticResource TextMuted}"
                                       Margin="0,12,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}" />

                            <ListBox ItemsSource="{Binding MarketResults}" Background="Transparent" BorderThickness="0"
                                     MaxHeight="280" Margin="0,10,0,0" ItemContainerStyle="{StaticResource CompactRow}"
                                     Visibility="{Binding HasMarketResults, Converter={StaticResource BoolToVis}}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock Text="  作者 " FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Author}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="  ·  " FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DownloadsText}" FontSize="10.5"
                                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Text=" 下载" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="选版本"
                                                    Height="28" FontSize="11.5" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.OpenVersionPickerCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="40,12,40,0" Padding="6"
                        Visibility="{Binding HasMods, Converter={StaticResource BoolToVis}}">
                    <ListBox ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ModRow}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="52">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Badge}" Background="{StaticResource BadgeBg}" Width="74"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlatformLabel}" FontSize="9.5" FontWeight="SemiBold"
                                                   Foreground="{Binding PlatformColor}"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SubTitle}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center" Margin="0,0,14,0"
                                              IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              Command="{Binding DataContext.ToggleModCommand,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="移除"
                                            Height="28" FontSize="11.5" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteModCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource Card}" Margin="40,12,40,0" Padding="28,30"
                        VerticalAlignment="Top"
                        Visibility="{Binding HasNoMods, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="这个版本还没有模组" FontSize="14"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                        <TextBlock Text="点右上角「导入模组」，或把 .jar 直接复制进上面那个目录"
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="4" Margin="40,14,40,24">
                    <TextBlock Text="Fabric 模组可跑在 Quilt 上；Forge 与 Fabric 模组互不通用。"
                               FontSize="10.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding OptiFineModButtonText}"
                            Width="200" Height="36" HorizontalAlignment="Right" FontSize="12.5"
                            Command="{Binding InstallOptiFineModCommand}"
                            IsEnabled="{Binding CanInstallOptiFineMod}"
                            Visibility="{Binding IsForgeProfile, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- ======================= page: accounts ================ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource PageFade}"
                          Visibility="{Binding IsAccountsPage, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="40,30,40,30" Width="640" HorizontalAlignment="Left">
                    <TextBlock Text="账户" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="微软账户可以进入正版服务器；离线账户只用于单机与离线服"
                               FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,6,0,22" />

                    <TextBlock Text="已添加的账户" Style="{StaticResource SectionLabel}" />
                    <ListBox ItemsSource="{Binding Accounts}" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource AccountRow}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             Margin="0,0,0,8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AvatarBg}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" Background="{StaticResource AccentTint}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="使用中" FontSize="10" Foreground="{StaticResource Accent}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeLabel}" FontSize="10.5"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="使用" Height="28" FontSize="11.5"
                                                Margin="0,0,6,0"
                                                IsEnabled="{Binding IsCurrent, Converter={StaticResource InverseBool}}"
                                                Command="{Binding DataContext.UseAccountCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource GhostButton}" Content="删除" Height="28" FontSize="11.5"
                                                Command="{Binding DataContext.RemoveAccountCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="添加微软账户（正版登录）" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="密码只在微软官方页面输入，令牌用 Windows DPAPI 加密后保存。需要先在「设置 → 微软账户」填好自己的 Azure 应用 ID —— 那样登录完成后浏览器会自动回到启动器。"
                                       FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,6,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="打开微软登录页"
                                        Height="40" Width="220" HorizontalAlignment="Left"
                                        Command="{Binding AddMicrosoftAccountCommand}" />
                                <!-- Without a client id the button above can only refuse, so
                                     offer the one action that unblocks it. -->
                                <Button Style="{StaticResource GhostButton}" Content="去填 client_id"
                                        Height="40" Padding="14,0" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding NeedsClientId, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding NavigateCommand}" CommandParameter="4" />
                            </StackPanel>
                            <TextBlock Text="{Binding MsClientIdHint}" FontSize="10.5"
                                       Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" />

                            <!-- Paste-back: the only flow that runs the full Minecraft consent
                                 for the built-in client id. -->
                            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                    Padding="14,12" Margin="0,12,0,0"
                                    Visibility="{Binding ShowPasteBox, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap"
                                               Text="浏览器里登录完之后，页面会变成一片空白 —— 那串网址就是结果。三步：" />
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="① 在浏览器按 Ctrl+L ② 按 Ctrl+C ③ 切回启动器（会自动填好并登录）" />
                                    <TextBlock FontSize="10.5" Foreground="{StaticResource Accent}"
                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                               Text="不用粘贴、不用点按钮；识别不到再手动贴到下面。" />

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding PasteCallbackUrl, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 Height="38" VerticalContentAlignment="Center"
                                                 TextWrapping="NoWrap" />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="完成登录"
                                                Height="38" Width="104" Margin="8,0,0,0"
                                                Command="{Binding CompletePasteLoginCommand}" />
                                    </Grid>

                                    <TextBlock FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="失败时下方会显示微软返回的原始错误（含 correlation_id），把它发出来就能定位。" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="皮肤与披风" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock FontSize="10.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,3,0,0"
                                       Text="正版账号可直接拉取；也可用 LittleSkin 或本地 PNG。进入游戏时由本机皮肤服务注入，不会上传到任何地方。" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Front view: head / body / arms / legs, 16x32 like PCL. -->
                                <Border Width="88" Height="176" Background="{StaticResource BgInput}"
                                        CornerRadius="8" Padding="6">
                                    <Image Source="{Binding SkinPreview}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Border Width="44" Height="68" Background="{StaticResource BgInput}"
                                            CornerRadius="6" Padding="3">
                                        <Image Source="{Binding CapePreview}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="披风" FontSize="10" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding SkinLabel}" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SkinModelHint}" FontSize="10.5"
                                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />

                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Style="{StaticResource GhostButton}" Content="用正版皮肤"
                                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                                Command="{Binding UseMojangSkinCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="导入 PNG"
                                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                                Command="{Binding ImportSkinFileCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="导入披风"
                                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                                Command="{Binding ImportCapeFileCommand}" />
                                        <Button Style="{StaticResource GhostButton}" Content="清除"
                                                Height="32" Padding="12,0" Margin="0,0,8,8"
                                                Command="{Binding RemoveSkinCommand}" />
                                    </WrapPanel>

                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LittleSkinName, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="32" VerticalContentAlignment="Center"
                                                 ToolTip="LittleSkin 用户名（不需要密码）" />
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                Content="用 LittleSkin 皮肤" Height="32" Padding="12,0"
                                                Margin="8,0,0,0" Command="{Binding UseLittleSkinCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="添加离线账户" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="输入一个名字即可，UUID 由服务端一致的离线规则生成。"
                                       FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding OfflineAccountName, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="16" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="添加"
                                        Margin="8,0,0,0" Command="{Binding AddOfflineAccountCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Azure 应用 ID（推荐填写 · 免费 · 一次）" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                       Margin="0,6,0,10"
                                       Text="填好之后点登录，浏览器登录完会自动跳回启动器，不用复制任何网址。只需注册一次，约 5 分钟：" />

                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       LineHeight="20" Margin="0,0,0,12">
                                <Run Text="0. 个人账户必须先有租户，否则会报「Microsoft Services 租户」或 401" FontWeight="SemiBold" /><LineBreak />
                                <Run Text="   有学校邮箱 → azure.microsoft.com/free/students（免卡）" /><LineBreak />
                                <Run Text="   有卡 → azure.microsoft.com/free（验 1 美元，注册不收费）" /><LineBreak />
                                <Run Text="   都没有 → 先用内置 id + 粘贴回调，或 developer.microsoft.com/microsoft-365/dev-program（会过期）" /><LineBreak />
                                <Run Text="   有租户后右上角头像 → 切换目录 → 再往下做" /><LineBreak />
                                <Run Text="A. 注册应用（约 3 分钟）" FontWeight="SemiBold" /><LineBreak />
                                <Run Text="1. Microsoft Entra ID → 应用注册 → 新注册" /><LineBreak />
                                <Run Text="2. 名称随便填（不能含 Minecraft / Mojang / Microsoft / Xbox）" /><LineBreak />
                                <Run Text="3. 账户类型选「仅个人 Microsoft 账户」，重定向 URI 留空 → 注册" /><LineBreak />
                                <Run Text="4. 身份验证 → 添加平台 → 移动和桌面应用程序 → 勾 http://localhost" /><LineBreak />
                                <Run Text="5. 同页底部 →「允许公共客户端流」设为「是」→ 保存" /><LineBreak />
                                <Run Text="B. 申请 Minecraft API 权限（每周审一次，可能要等几天）" FontWeight="SemiBold" /><LineBreak />
                                <Run Text="6. 点下面「申请 Minecraft 权限」，类型选 New AppID for Approval" /><LineBreak />
