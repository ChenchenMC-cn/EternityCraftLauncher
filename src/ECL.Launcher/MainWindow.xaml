                </DockPanel>
            </Border>
        </Grid>

        <!-- ================================= dependency prompt overlay ====== -->
        <Grid Grid.Row="1" Panel.ZIndex="70"
              Visibility="{Binding IsDependencyPromptOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B3000000" />

            <Border Width="540" MaxHeight="520" Margin="24"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource WarnCardBorder}" BorderThickness="1"
                    CornerRadius="12" Padding="20,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding DependencyPromptTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="游戏启动时会因为缺这些模组而崩溃。现在补上，还是稍后自己处理？"
                                   FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer DockPanel.Dock="Top" MaxHeight="300" Margin="0,14,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding MissingDependencies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                            Padding="12,10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="被 " />
                                                    <Run Text="{Binding RequiredBy, Mode=OneWay}" />
                                                    <Run Text=" 需要" />
                                                </TextBlock>
                                            </StackPanel>

                                            <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                                    Content="去安装" Height="28" FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ResolveDependencyCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="稍后再说"
                                Width="110" Height="34"
                                Command="{Binding DismissDependencyPromptCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============================================ status bar ======== -->
        <Border Grid.Row="2" Background="{StaticResource BgSidebar}"
                BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.ColumnSpan="3" Style="{StaticResource ThinProgress}"
                             Value="{Binding ProgressValue}" Maximum="1" VerticalAlignment="Top" />

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="11.5"
                           Foreground="{StaticResource Accent}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <!-- task menu: only useful once something is running or recently finished -->
                <ToggleButton x:Name="TaskToggle" Grid.Column="2"
                              Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}"
                              Background="Transparent" BorderThickness="0" Padding="8,0"
                              Cursor="Hand" Margin="0,0,6,0"
                              ToolTip="查看任务">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{StaticResource Accent}"
                                 Visibility="{Binding HasRunningTask, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding TaskSummary}" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                   Foreground="{StaticResource TextMuted}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <Popup x:Name="TaskPopup" IsOpen="{Binding IsChecked, ElementName=TaskToggle, Mode=TwoWay}"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       PlacementTarget="{Binding ElementName=TaskToggle}" Placement="Top">
                    <Border Background="{StaticResource BgPanel}"
                            BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                            CornerRadius="10" Padding="6" Margin="0,0,10,10"
                            Width="430" MaxHeight="340">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="8,6,8,6">
                                <TextBlock Text="{Binding TaskSummary}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                <Button Content="清空已完成" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}" Height="24" FontSize="10.5"
                                        Padding="10,0" Command="{Binding ClearFinishedTasksCommand}" />
                            </Grid>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCard}" CornerRadius="8"
                                                    Padding="10,8" Margin="4,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}"
                                                             VerticalAlignment="Top" Margin="0,5,9,0" />

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10.5"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StateLabel}" FontSize="10"
                                                                   Foreground="{Binding StateBrush}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <Button Content="取消" Style="{StaticResource GhostButton}"
                                                                Height="24" FontSize="10.5" Padding="10,0"
                                                                Command="{Binding CancelCommand}"
                                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
