<Window x:Class="ECL.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eternity Craft Launcher"
        Width="840" Height="680" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header + language picker -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock x:Name="SubtitleText" FontSize="11.5"
                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="LanguageLabel" Text="语言" FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="LanguageBox" Width="200" Height="32"
                          DisplayMemberPath="Display"
                          SelectionChanged="OnLanguageChanged"
                          VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- shown when the picked language has no hand-written translation -->
        <Border x:Name="FallbackNotice" Grid.Row="1" Visibility="Collapsed"
                Background="{StaticResource WarnCardBg}" BorderBrush="{StaticResource WarnCardBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="FallbackText" FontSize="11" Foreground="{StaticResource WarnText}"
                       TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl x:Name="BlocksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Heading}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" FontSize="12.5" LineHeight="22"
                                               Foreground="{StaticResource TextSecondary}"
                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,4,0,14" />

                    <TextBlock x:Name="SignatureText" FontSize="11.5" LineHeight="20"
                               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    <TextBlock x:Name="VersionText" FontSize="10.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="AcceptHint" Grid.Column="0" FontSize="10.5"
                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,16,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="DeclineButton" Style="{StaticResource GhostButton}" Content="退出"
                        Width="110" Height="38" Click="OnDecline" />
                <!-- MinWidth, not Width: "Agree and continue" is much longer than the
                     Chinese label and a fixed 150 px pushed it into the window edge. -->
                <Button x:Name="AcceptButton" Style="{StaticResource PrimaryButton}" Content="同意并继续"
                        MinWidth="150" Height="38" Padding="20,0" Margin="10,0,0,0" Click="OnAccept" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
